# LLM — get a free key at https://console.groq.com
# Default model: qwen/qwen3.8-27b (available on all Groq accounts)
GROQ_API_KEY=your_groq_api_key_here

# Vector DB (local, no key needed)
CHROMA_PERSIST_DIR=./data/chroma

# PDF cache
PDF_CACHE_DIR=./data/pdfs

# SQLite (LangGraph checkpointer + bookings)
SQLITE_DB_PATH=./data/agent_state.db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG tuning
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=150
RAG_CONFIDENCE_THRESHOLD=0.3

# Auth
JWT_SECRET=hr-assistant-super-secret-change-in-prod
